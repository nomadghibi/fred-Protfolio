# Optional contact form configuration.
# Use EmailJS, or provide NEXT_PUBLIC_CONTACT_EMAIL for a mailto fallback.
NEXT_PUBLIC_SERVICE_ID=""
NEXT_PUBLIC_TEMPLATE_ID=""
NEXT_PUBLIC_PUBLIC_KEY=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# GitHub stat-card services. These defaults work without configuration,
# but can be replaced with your own hosted instances.
NEXT_PUBLIC_GITHUB_STATS_URL="https://github-readme-stats.vercel.app"
NEXT_PUBLIC_GITHUB_STREAK_STATS_URL="https://github-readme-streak-stats.herokuapp.com"
